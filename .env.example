# Copy to .env.local for the Next.js app.
# Also copy POSTGRES_* into a gitignored .env file next to docker-compose.yml.
# Compose interpolates ${POSTGRES_PASSWORD} from that .env file, not from .env.local.

POSTGRES_USER=ithink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ithinksite

# Inside docker-compose the host name is "postgres". On the host machine it is "localhost".
DATABASE_URL=postgresql://ithink:change-me@localhost:5432/ithinksite

# NextAuth session secret for the client portal and /admin. openssl rand -base64 32
AUTH_SECRET=
# Required behind a reverse proxy (the Docker deploy).
AUTH_TRUST_HOST=true

# Existing portal env-var login. Also used by `node prisma/seed-users.mjs`
# and POST /api/admin/seed (Bearer AUTH_SECRET).
PORTAL_ADMIN_EMAIL=admin@ithinksys.co.zw
PORTAL_ADMIN_PASSWORD=
PORTAL_DEMO_EMAIL=demo@ithinksys.co.zw
PORTAL_DEMO_PASSWORD=

# Bearer token for the assistant API:
#   /api/admin/posts  /api/admin/products  /api/admin/media
# openssl rand -base64 32
CMS_API_TOKEN=

# Where uploaded images are copied. In Docker this is the uploads_data volume.
# The bytes are also stored in Postgres (MediaAsset), so a container rebuild keeps them.
UPLOAD_DIR=./data/uploads

# Optional analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
